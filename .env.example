# Hangs v2 production environment (the variables Vercel needs). Copy to .env.local only for production-like runs.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=
# Secret key for the keyed hash of IP addresses in rate_limits (any long random string). Falls back to
# TURSO_AUTH_TOKEN when unset.
HANGS_RL_SECRET=
# Local only, never set on Vercel: `npm run dev`, `npm test`, `build:local` and `start` already set
# HANGS_LOCAL_DB=1, which forces the file database (file:hangs-v2.local.db) and ignores the Turso variables.
# HANGS_LOCAL_DB=1
